# Copy to .env for local runs. On GitHub, add these as repository Secrets instead (never commit .env).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free AI (at least one): https://aistudio.google.com/apikey  |  https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Encrypts your CV, listings and the website. Long and unique: the encrypted page is public.
DASHBOARD_PASSWORD=
DASHBOARD_URL=

# Optional: Adzuna job search (free developer key at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: Jooble (https://jooble.org/api/about) and Reed UK (https://www.reed.co.uk/developers/jobseeker)
JOOBLE_API_KEY=
REED_API_KEY=

# Optional: Gmail replies + Google Sheet database through your own Apps Script (see README)
GMAIL_WEBAPP_URL=
GMAIL_WEBAPP_KEY=
# Older alternative (IMAP with an app password), used only if the two lines above are empty
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
